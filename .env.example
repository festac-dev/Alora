# Local development database (single process). Stop `pnpm dev` before CLI actions.
DATABASE_URL=pglite:./data/pglite

# Hosted deployment: use a persistent PostgreSQL URL instead.
# DATABASE_URL=postgres://user:pass@host:5432/alora?sslmode=require

# Optional: only needed for the in-app chat agent, not for the verified workflow.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Custom health check message
PING_MESSAGE=pong

# Static bearer token for MCP/connect clients. Not browser auth; see README.
# ACCESS_TOKEN=

# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true
# BETTER_AUTH_SECRET=
